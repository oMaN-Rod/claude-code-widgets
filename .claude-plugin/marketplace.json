      "author": {
        "name": "oMaN-Rod",
        "email": "orod41285@gmail.com"
      },
      "category": "widgets",
      "repository": "https://github.com/oMaN-Rod/claude-code-widgets",
      "keywords": [
        "files",
        "widgets"
