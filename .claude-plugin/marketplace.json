{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "claude-code-widgets",
  "description": "Live widgets for Claude Code: context, usage and file tree cards, plus a pixel pet, skyline, aquarium, weather and snake.",
  "owner": {
    "name": "oMaN-Rod",
    "email": "orod41285@gmail.com"
  },
  "metadata": {
    "description": "Live widgets for Claude Code, built as mods.",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "widgets",
      "source": "./plugins/widgets",
      "description": "Layout for the widget cards: below the prompt, above it, or docked beside the transcript. Required by every widget.",
      "version": "1.0.0",
      "author": {
        "name": "oMaN-Rod",
        "email": "orod41285@gmail.com"
      },
      "category": "widgets",
      "repository": "https://github.com/oMaN-Rod/claude-code-widgets",
      "keywords": [
        "layout",
        "widgets"
      ],
      "license": "MIT"
    },
    {
      "name": "context-widget",
      "source": "./plugins/context-widget",
      "description": "The context window as a stacked bar, one colour per /context category, with six view modes.",
      "version": "1.0.0",
      "author": {
        "name": "oMaN-Rod",
        "email": "orod41285@gmail.com"
      },
      "category": "widgets",
      "repository": "https://github.com/oMaN-Rod/claude-code-widgets",
      "keywords": [
        "context",
        "widgets"
      ],
      "license": "MIT"
    },
    {
      "name": "usage-widget",
      "source": "./plugins/usage-widget",
      "description": "A bar per rate-limit window with time to reset and session cost.",
      "version": "1.0.0",
      "author": {
        "name": "oMaN-Rod",
        "email": "orod41285@gmail.com"
      },
      "category": "widgets",
      "repository": "https://github.com/oMaN-Rod/claude-code-widgets",
      "keywords": [
        "usage",
        "rate-limits",
        "widgets"
      ],
      "license": "MIT"
    },
    {
      "name": "file-tree-widget",
